    "note": "Critical wounds recalled as a natural 10, with luck lowering the threshold."
   },
   "monsterLanternAlwaysHits": {
    "status": "unverified",
    "note": "Whether a monster's natural 10 always hits is not confirmed; off here."
   },
   "maxDeparting": {
    "status": "unverified",
    "note": "Recalled as 4 departing survivors."
   },
   "huntBoardLength": {
    "status": "unverified",
    "note": "Hunt board length recalled as 12 spaces after the starting space."
   },
   "endeavorsPerReturningSurvivor": {
    "status": "unverified",
    "note": "Endeavor income is simplified to 1 per returning survivor."
   },
   "unarmedWeapon": {
    "status": "standin",
    "note": "Original stand-in unarmed attack (speed 2, accuracy 8+, strength 0)."
   },
   "diagonalMovement": {
    "status": "unverified",
    "note": "Recalled that movement and adjacency are orthogonal only (no diagonals)."
   },
   "injuryPerHit": {
    "status": "unverified",
    "note": "Recalled that a hit whose damage gets past armor raises the injury at that location by one level (light, then heavy, then a severe injury roll), however much damage is left over."
   },
   "dodge": {
    "status": "unverified",
    "note": "Recalled that survivors start able to spend 1 survival to dodge one hit, once per round."
   },
   "monsterActsFirst": {
    "status": "unverified",
    "note": "Recalled that each showdown round starts with the monster turn, then the survivors’ turn."
   },
   "knockdown": {
    "status": "unverified",
    "note": "Knocked-down survivors here skip their next activation and stand at the end of the survivors’ turn. Confirm the official timing."
   },
   "monsterDeath": {
    "status": "unverified",
    "note": "Here a wound takes the top AI card; an empty AI deck is refilled from the discard; a wound with no AI cards left anywhere slays the monster."
   },
   "monsterMovement": {
    "status": "unverified",
    "note": "The monster moves orthogonally toward its target, around survivors, and stops when adjacent; collision and knockback-into-monster rules are not implemented."
   },
   "huntBoard": {
    "status": "standin",
    "note": "The hunt is simplified: survivors advance one space per hunt turn and resolve one event; reaching the quarry starts the showdown."
   }
